# 飞书自建应用凭证（复制本文件为 .env 后填写真实值，.env 已被 gitignore）
# 获取路径：open.feishu.cn -> 开发者后台 -> 你的应用 -> 凭证与基础信息

FEISHU_APP_ID=
FEISHU_APP_SECRET=

# 可选：海外 Lark 改为 https://open.larksuite.com ，国内版保持默认即可
# FEISHU_HOST=https://open.feishu.cn

# ---- 写入（输出到飞书文档）目标 wiki 节点（可选，用 create_document 工具时需要）----
# 新文档作为该 wiki 节点的子节点创建。该节点需分享为「组织内可编辑」，应用才有写权限。
# FEISHU_WIKI_SPACE_ID 为知识库 space_id；FEISHU_WIKI_PARENT_NODE 为 /wiki/<token> 中的 token。
FEISHU_WIKI_SPACE_ID=
FEISHU_WIKI_PARENT_NODE=

# 可选：你的飞书租户域名，用于把写入结果拼成可点击的 wiki 链接
# 例：your-tenant.feishu.cn（从任意飞书文档链接里取域名部分）
# FEISHU_WIKI_DOMAIN=your-tenant.feishu.cn
